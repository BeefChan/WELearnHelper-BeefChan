# Default deny: only reviewed publication files are tracked.
/*
!/.gitignore
!/README.md
!/LICENSE
!/UPSTREAM.md
!/CHANGELOG.md
!/src/
/src/*
!/src/manifest.json
!/src/index.js
!/src/background.js
!/src/content.js
!/src/inject.js
!/src/ui.css
!/src/icon.png
!/tools/
/tools/*
!/tools/cdp.mjs
!/tools/auto-next-selftest.mjs
!/tools/sco-selection-selftest.mjs
!/tools/ui-selftest.mjs
!/docs/
/docs/*
!/docs/INSTALL.md
!/PATCHES.md
!/upstream/
/upstream/*
!/upstream/v1.1.0/
!/upstream/v1.1.0/**

# Never publish secrets, local browser profiles, or generated artifacts.
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.log
*.zip
*.crx
**/node_modules/
**/__pycache__/
**/edge-automation/
**/recon/
**/backup/
**/dist/

# Upstream build flag is a non-secret compile switch; keep it for reproducible builds.
!/upstream/v1.1.0/.env

# npm-generated lockfile for the vendored upstream project (upstream uses pnpm).
/upstream/v1.1.0/package-lock.json
